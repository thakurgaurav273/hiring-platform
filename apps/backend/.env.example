# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000


DATABASE_URL="postgresql://postgres:password123@localhost:5432/grovyn_db?schema=public"

JWT_SECRET= ""
JWT_EXPIRY=3d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# Storage Configuration (local, s3, r2)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR="./uploads"

# AWS S3 (Required if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Cloudflare R2 (Required if STORAGE_PROVIDER=r2)
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Email Configuration (resend, smtp)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Grovyn Talent <no-reply@grovyn.com>"

# Resend Email (Required if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# SMTP (Required if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Rate Limiting (on by default in production, off in development; set to override)
RATE_LIMIT_ENABLED=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Firebase Admin (Cloud Messaging push notifications) ───────────────────────
# Get these from: Firebase Console → Project Settings → Service Accounts → Generate key
# Then copy the values from the downloaded JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value here (keep the \n as literal \n)
FIREBASE_PRIVATE_KEY=