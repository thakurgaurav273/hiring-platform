// ============================================================
// Grovyn Talent — ATS Backend
// Prisma Schema (PostgreSQL)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
}

enum PipelineStage {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  TECHNICAL_ROUND
  HR_ROUND
  OFFER_SENT
  HIRED
  REJECTED
}

enum TimelineEventType {
  CANDIDATE_CREATED
  RESUME_UPLOADED
  STATUS_UPDATED
  EMAIL_SENT
  EMAIL_REPLIED
  INTERVIEW_SCHEDULED
  NOTE_ADDED
  FEEDBACK_ADDED
  OFFER_GENERATED
  APPLICATION_CREATED
  CUSTOM
}

enum NoteType {
  PRIVATE
  GENERAL
}

enum FeedbackType {
  TECHNICAL
  HR
}

enum Recommendation {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}

enum InterviewType {
  SCREENING
  TECHNICAL
  HR
  MANAGERIAL
  FINAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  REPLIED
  BOUNCED
}

enum StorageProvider {
  S3
  R2
  LOCAL
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  firstName    String
  lastName     String
  role         Role     @default(RECRUITER)
  isActive     Boolean  @default(true)
  avatarUrl    String?
  invitedById  String?
  invitedBy    User?    @relation("UserInvites", fields: [invitedById], references: [id])
  invitedUsers User[]   @relation("UserInvites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens     RefreshToken[]
  jobsAsRecruiter   Job[]              @relation("JobRecruiter")
  notes             Note[]
  feedbacks         Feedback[]
  timelineEvents    TimelineEvent[]
  sentEmails        Email[]            @relation("EmailSender")
  stageChanges      PipelineHistory[]
  interviewPanel    InterviewPanelist[]
  emailTemplates    EmailTemplate[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

// ============================================================
// JOBS
// ============================================================

model Job {
  id            String         @id @default(uuid())
  title         String
  department    String
  employmentType EmploymentType
  experience    String
  skills        String[]
  description   String
  salaryMin     Int?
  salaryMax     Int?
  status        JobStatus      @default(DRAFT)
  numOpenings   Int            @default(1)

  recruiterId   String
  recruiter     User           @relation("JobRecruiter", fields: [recruiterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications     Application[]
  pipelineTemplate PipelineTemplate?

  @@index([status])
  @@index([recruiterId])
  @@map("jobs")
}

// ============================================================
// CANDIDATES
// ============================================================

model Candidate {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  skills      String[]
  experience  Json?    // structured list of past roles
  education   Json?    // structured list of degrees
  socialLinks Json?    // { linkedin, github, portfolio, ... }
  tags        String[]
  source      String?  // e.g. referral, LinkedIn, careers page

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes        Resume[]
  applications   Application[]
  notes          Note[]
  timelineEvents TimelineEvent[]
  emails         Email[]

  @@unique([email])
  @@index([email])
  @@map("candidates")
}

model Resume {
  id              String          @id @default(uuid())
  candidateId     String
  candidate       Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileName        String
  fileUrl         String
  fileSize        Int
  mimeType        String
  storageProvider StorageProvider @default(LOCAL)
  isActive        Boolean         @default(true)
  uploadedAt      DateTime        @default(now())

  @@index([candidateId])
  @@map("resumes")
}

// ============================================================
// HIRING PIPELINE
// ============================================================

// One Application = one Candidate applying to one Job
model Application {
  id            String        @id @default(uuid())
  candidateId   String
  candidate     Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  currentStage  PipelineStage @default(APPLIED)
  appliedAt     DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history     PipelineHistory[]
  feedbacks   Feedback[]
  interviews  Interview[]
  notes       Note[]
  timelineEvents TimelineEvent[]
  emails      Email[]

  @@unique([candidateId, jobId])
  @@index([jobId])
  @@index([candidateId])
  @@index([currentStage])
  @@map("applications")
}

// Configurable pipeline per job (falls back to default if none set)
model PipelineTemplate {
  id        String   @id @default(uuid())
  name      String
  jobId     String?  @unique
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages PipelineStageDefinition[]

  @@map("pipeline_templates")
}

model PipelineStageDefinition {
  id         String           @id @default(uuid())
  templateId String
  template   PipelineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stage      PipelineStage
  order      Int
  label      String?

  @@unique([templateId, stage])
  @@index([templateId])
  @@map("pipeline_stage_definitions")
}

// Audit log for every stage transition
model PipelineHistory {
  id            String        @id @default(uuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     PipelineStage?
  toStage       PipelineStage
  changedById   String
  changedBy     User          @relation(fields: [changedById], references: [id])
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([applicationId])
  @@map("pipeline_history")
}

// ============================================================
// INTERVIEWS
// ============================================================

model Interview {
  id            String          @id @default(uuid())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          InterviewType
  status        InterviewStatus @default(SCHEDULED)
  scheduledAt   DateTime
  durationMins  Int             @default(30)
  location      String?
  meetingLink   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panelists InterviewPanelist[]
  feedbacks Feedback[]

  @@index([applicationId])
  @@index([scheduledAt])
  @@map("interviews")
}

// Join table: many interviewers per interview
model InterviewPanelist {
  id           String    @id @default(uuid())
  interviewId  String
  interview    Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerId String
  interviewer  User      @relation(fields: [interviewerId], references: [id])

  @@unique([interviewId, interviewerId])
  @@map("interview_panelists")
}

// ============================================================
// NOTES & FEEDBACK
// ============================================================

model Note {
  id            String       @id @default(uuid())
  candidateId   String
  candidate     Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User         @relation(fields: [authorId], references: [id])
  type          NoteType     @default(GENERAL)
  content       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([applicationId])
  @@map("notes")
}

model Feedback {
  id             String          @id @default(uuid())
  applicationId  String
  application    Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewId    String?
  interview      Interview?      @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  interviewerId  String
  interviewer    User            @relation(fields: [interviewerId], references: [id])
  type           FeedbackType
  rating         Int             // e.g. 1-5
  recommendation Recommendation
  comments       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@map("feedbacks")
}

// ============================================================
// TIMELINE
// ============================================================

model TimelineEvent {
  id            String            @id @default(uuid())
  candidateId   String
  candidate     Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          TimelineEventType
  title         String
  description   String?
  metadata      Json?
  actorId       String?
  actor         User?             @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([candidateId])
  @@index([applicationId])
  @@index([createdAt])
  @@map("timeline_events")
}

// ============================================================
// EMAIL
// ============================================================

model Email {
  id                String         @id @default(uuid())
  candidateId       String
  candidate         Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId     String?
  application       Application?   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromUserId        String?
  fromUser          User?          @relation("EmailSender", fields: [fromUserId], references: [id])
  to                String
  cc                String[]
  subject           String
  body              String
  direction         EmailDirection
  threadId          String?
  provider          String         @default("resend")
  providerMessageId String?
  status            EmailStatus    @default(QUEUED)
  attachments       Json?

  createdAt DateTime @default(now())

  @@index([candidateId])
  @@index([applicationId])
  @@index([threadId])
  @@map("emails")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  subject     String
  body        String
  type        String   // e.g. interview-invite, offer-letter, rejection
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}
